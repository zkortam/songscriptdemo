# Supabase — server-only. Do NOT prefix with NEXT_PUBLIC (the service key must never reach the browser).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Run supabase/schema.sql in the SQL editor first.
